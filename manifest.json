{
  "manifest_version": 3,
  "name": "SpotlightPro",
  "version": "1.2.0",
  "description": "Make any webpage instantly yours",
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": ["activeTab", "scripting"]
}